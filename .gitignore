```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Test coverage and cache
.pytest_cache/
.coverage
coverage/
htmlcov/

# Build and distribution
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
```